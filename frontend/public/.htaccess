<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --------------------------------------------------------------------------
  # Canonical scheme + host
  # Every other rule below assumes one canonical origin: https://theifoa.com
  # (no www), matching <link rel="canonical"> and sitemap.xml. The
  # X-Forwarded-Proto check keeps this loop-safe when TLS terminates upstream.
  # --------------------------------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ==========================================================================
  # 301s from the previous WordPress site.
  #
  # These URLs are indexed and carry existing ranking signal. A 301 passes that
  # signal to the new URL; a 404 throws it away. Keep these rules for at least
  # a year after launch.
  #
  # NOTE: rules marked [CONSOLIDATED] point several old pages at one new page
  # because the new site has no equivalent. Google treats a redirect to a
  # non-equivalent page as a soft 404 and passes little or no ranking signal,
  # so these recover far less than a like-for-like page would. Replacing them
  # with real pages is tracked as follow-up work.
  # ==========================================================================

  # --- About ---------------------------------------------------------------
  RewriteRule ^about-us/?$                      /about [L,R=301]
  RewriteRule ^about-us/team/?$                 /about [L,R=301]
  RewriteRule ^about-us/ifoa-brand/?$           /about [L,R=301]

  # --- Per-discipline service pages [CONSOLIDATED] -------------------------
  # Each of these was its own keyword-targeted landing page on WordPress.
  RewriteRule ^services/flight-dispatch/?$          /services [L,R=301]
  RewriteRule ^services/ground-operations/?$        /services [L,R=301]
  RewriteRule ^services/train-the-trainer/?$        /services [L,R=301]
  RewriteRule ^services/consulting-services/?$      /services [L,R=301]
  RewriteRule ^services/crew-control/?$             /services [L,R=301]
  RewriteRule ^services/aviation-sustainability/?$  /services [L,R=301]
  RewriteRule ^services/dangerous-goods/?$          /services [L,R=301]

  # --- Magazine / blog [CONSOLIDATED] --------------------------------------
  RewriteRule ^blog/?$ /foxtrot-delta [L,R=301]
  RewriteRule ^foxtrot-delta-magazine-special-edition-aviation-sustainability/?$ /foxtrot-delta [L,R=301]
  RewriteRule ^foxtrot-delta-edition-1-air-mauritius/?$  /foxtrot-delta [L,R=301]
  RewriteRule ^foxtrot-delta-edition-2-jetfly-occ/?$     /foxtrot-delta [L,R=301]
  RewriteRule ^ifoa-2022-review/?$                       /foxtrot-delta [L,R=301]
  RewriteRule ^ifoa-activities-review-q1-2023/?$         /foxtrot-delta [L,R=301]
  RewriteRule ^ifoa-activities-review-q2-2023/?$         /foxtrot-delta [L,R=301]

  # --- Events -> course pages ----------------------------------------------
  RewriteRule ^event/ifoa-india-4-weeks-flight-operations-flight-dispatch-program-ref-ipin2501/?$ /courses/flight-dispatcher-initial-certification [L,R=301]
  RewriteRule ^event/4-weeks-easa-flight-dispatch-initial-course-ref-fdin2403/?$ /courses/flight-dispatcher-initial-certification [L,R=301]
  RewriteRule ^event/4-weeks-easa-flight-dispatch-initial-course-ref-fdin2401/?$ /courses/flight-dispatcher-initial-certification [L,R=301]
  RewriteRule ^event/4-weeks-easa-flight-dispatch-course-prom2-2023/?$          /courses/flight-dispatcher-initial-certification [L,R=301]
  RewriteRule ^event/3-days-easa-flight-dispatch-recurrent-online-course-module-1-2023/?$ /events [L,R=301]
  RewriteRule ^event/4-days-easa-crew-control-frm-online-course-2023/?$         /services [L,R=301]
  RewriteRule ^3-weeks-easa-flight-dispatch-initial-course-prom1-2023/?$        /events [L,R=301]
  RewriteRule ^ifoa-india-landing-page/?$ /courses/flight-dispatcher-initial-certification [L,R=301]
  # Any remaining Events Calendar URL.
  RewriteRule ^event/.*$  /events [L,R=301]
  RewriteRule ^events/.+$ /events [L,R=301]
  # Events Calendar venue and organizer pages.
  RewriteRule ^venue/.*$     /events [L,R=301]
  RewriteRule ^organizer/.*$ /about  [L,R=301]

  # --- Legal / misc [CONSOLIDATED] -----------------------------------------
  # /impressum and /data-protection-policy have no replacement yet. An Impressum
  # is a legal requirement for the Swiss entity, so these need real pages.
  RewriteRule ^impressum/?$               /contact [L,R=301]
  RewriteRule ^data-protection-policy/?$  /contact [L,R=301]
  RewriteRule ^faq/?$                     /contact [L,R=301]
  RewriteRule ^landing-page/?$            / [L,R=301]

  # --- Agent for Service (separate product, separate host) -----------------
  RewriteRule ^agent-for-service(/.*)?$ https://agent.theifoa.com/ [L,R=301]

  # --- Dead WordPress surface ----------------------------------------------
  # Kill crawl budget spent on URLs that will never exist again.
  RewriteRule ^(wp-admin|wp-login\.php|wp-json|xmlrpc\.php|feed|comments/feed)(/.*)?$ - [R=410,L]
  RewriteRule ^(category|tag|author|fl-builder-template-category)/.*$ - [R=410,L]

  # ==========================================================================
  # Prerendered routes
  # Serve /about from /about/index.html directly. DirectorySlash is off so
  # Apache does not 301 /about -> /about/, which would fight the canonical.
  # ==========================================================================
  DirectorySlash Off

  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^([^.]+?)/?$ /$1/index.html [L]

  # Real files and directories pass through untouched.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else: SPA shell (admin console, enrollment forms, and any route
  # added after the last build). The app renders a noindex 404 for unknown paths.
  RewriteRule ^ /index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/x-javascript application/json \
    image/svg+xml application/xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ----------------------------------------------------------------------
# Caching: hashed assets are immutable, HTML must always revalidate
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|gif|svg|webp|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Misc hardening
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
