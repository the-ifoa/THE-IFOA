# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017/ifoa

# ---- Auth ----
# Use a long random string. Generate: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=ifoa_admin_token

# Used once by `npm run seed:admin` to create the first admin account.
SEED_ADMIN_EMAIL=admin@theifoa.com
SEED_ADMIN_PASSWORD=change_me
SEED_ADMIN_NAME=IFOA Admin

# ---- SMTP (contact form) ----
SMTP_HOST=mail.theifoa.com
SMTP_PORT=465
SMTP_USER=info@theifoa.com
SMTP_PASS=change_me
# Inbox that receives enrollment and contact-form emails (default info@theifoa.com)
MAIL_TO=info@theifoa.com

# ---- SMTP India ----
# India enrollments/inquiries are sent from this mailbox to itself.
# Host/port fall back to SMTP_HOST/SMTP_PORT. Unset = India mail goes to MAIL_TO.
SMTP_INDIA_HOST=mail.theifoa.com
SMTP_INDIA_PORT=465
SMTP_INDIA_USER=info-india@theifoa.com
SMTP_INDIA_PASS=change_me
MAIL_TO_INDIA=info-india@theifoa.com

# ---- Cloudflare R2 ----
# Dashboard: R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ifoa-media
# Public bucket URL or custom domain, no trailing slash.
# e.g. https://pub-xxxxxxxx.r2.dev  or  https://media.theifoa.com
R2_PUBLIC_BASE_URL=
